<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="lms.seihaglobalacademy.com.SiteMaster" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - SGA LMS</title>
    
    <!-- Material Icons for the Sidebar -->
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons+Outlined" rel="stylesheet" />
    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />

    <link href="/assets/css/Site.css?v=105" rel="stylesheet" type="text/css" />

    <asp:ContentPlaceHolder ID="HeadContent" runat="server"></asp:ContentPlaceHolder>
</head>
<body class="lms-master-body">
    <script type="text/javascript">
        // Pre-load checks to prevent layout flickering before the page renders
        if (localStorage.getItem("lms-theme") === "light") {
            document.body.classList.add("light-mode");
        }
        if (localStorage.getItem("lms-high-contrast") === "enabled") {
            document.body.classList.add("high-contrast");
        }
    </script>

    <form id="mainRenderForm" runat="server">
        <asp:ScriptManager runat="server"></asp:ScriptManager>

        <!-- Sidebar Navigation Shell UI -->
        <nav class="lms-sidebar">
            <div class="sidebar-logo-container">
                <img src="assets/images/sgalogo.png" class="sidebar-brand-img" alt="SGA Logo" />
            </div>

            <!-- Account Trigger linked to slide open the accountDrawerPanel -->
            <a class="nav-item" href="javascript:void(0);" onclick="toggleDrawer('accountDrawerPanel', this);">
                <i class="material-icons-outlined">account_circle</i>Account
            </a>
            <a class="nav-item" href="Dashboard.aspx"><i class="material-icons-outlined">dashboard</i>Dashboard</a>
            <a class="nav-item" href="Courses.aspx"><i class="material-icons-outlined">class</i>Courses</a>
            <a class="nav-item" href="Calendar.aspx"><i class="material-icons-outlined">calendar_month</i>Calendar</a>
            <a class="nav-item" href="Inbox.aspx"><i class="material-icons-outlined">mail</i>Inbox</a>
            
            <a class="nav-item" href="javascript:void(0);" onclick="toggleDrawer('historyDrawerPanel', this);">
                <i class="material-icons-outlined">history</i>History
            </a>
            
            <a class="nav-item" href="Studio.aspx"><i class="material-icons-outlined">video_library</i>Studio</a>
            
            <div class="sidebar-footer">
                <a class="nav-item" href="javascript:void(0);" onclick="toggleDrawer('helpDrawerPanel', this);">
                    <i class="material-icons-outlined">help_outline</i>Help
                </a>
                
                <!-- Native Vertical Sidebar Logout Item -->
                <asp:LinkButton ID="lnkLogout" runat="server" CssClass="nav-item logout-nav-item" OnClick="lnkLogout_Click">
                    <i class="material-icons-outlined" style="color: #ff5252;">logout</i>
                    <span style="color: #ff5252; font-weight: 600;">Logout</span>
                </asp:LinkButton>
            </div>
        </nav>

        <!-- Pop-Up Account Drawer Content Panel -->
        <div class="lms-slide-drawer" id="accountDrawerPanel">
            <!-- Header containing close button aligned to the right -->
            <div class="drawer-header" style="justify-content: flex-end; margin-bottom: 15px;">
                <button type="button" class="close-drawer-btn" onclick="closeAllDrawers();" style="border: 1px solid var(--border-color); padding: 4px 6px; border-radius: 4px; background: rgba(255,255,255,0.05); display: flex; align-items: center; justify-content: center;">
                    <i class="material-icons-outlined" style="font-size: 16px;">close</i>
                </button>
            </div>

            <!-- Profile Presentation Section -->
            <div class="account-profile-section">
                <div class="avatar-badge">TA</div>
                <h3 class="user-display-name">TROWA ADRIAN</h3>
            </div>

            <!-- Quick Access Navigation List -->
            <ul class="account-menu-list">
                <li><a href="Notifications.aspx">Notifications</a></li>
                <li><a href="Profile.aspx">Profile</a></li>
                <li><a href="Files.aspx">Files</a></li>
                <li><a href="Settings.aspx">Settings</a></li>
                <li><a href="Portfolio.aspx">Portfolio</a></li>
                <li><a href="Announcements.aspx">Global Announcements</a></li>
            </ul>

            <!-- Accessibility Controls Section -->
            <div class="accessibility-settings-container">
                <h4>Accessibility Settings</h4>
                
                <!-- Sun & Moon Theme Switch Control -->
                <div class="accessibility-option-row" style="margin-bottom: 18px; display: flex; align-items: center; gap: 10px;">
                    <label class="theme-switch">
                        <input type="checkbox" id="chkThemeToggle" onchange="toggleSiteTheme(this.checked);" />
                        <span class="slider"></span>
                    </label>
                    <span class="option-label-text" style="cursor: pointer; margin-left: 4px;" onclick="document.getElementById('chkThemeToggle').click();">
                        Use Light Mode
                    </span>
                    <span class="info-help-icon"><i class="material-icons-outlined">help_outline</i></span>
                </div>

                <!-- Use High Contrast UI -->
                <div class="accessibility-option-row" onclick="toggleHighContrast();" style="cursor: pointer;">
                    <span class="toggle-icon" id="highContrastToggleIcon">
                        <i class="material-icons-outlined">cancel</i>
                    </span>
                    <span class="option-label-text">Use High Contrast UI</span>
                    <span class="info-help-icon"><i class="material-icons-outlined">help_outline</i></span>
                </div>

                <div class="accessibility-option-row">
                    <span class="toggle-icon unchecked"><i class="material-icons-outlined">cancel</i></span>
                    <span class="option-label-text">Use a Dyslexia Friendly Font</span>
                    <span class="info-help-icon"><i class="material-icons-outlined">help_outline</i></span>
                </div>
            </div>
        </div>

        <!-- Pop-Up History Drawer Content Panel -->
        <div class="lms-slide-drawer" id="historyDrawerPanel">
            <div class="drawer-header">
                <h2>Recent History</h2>
                <button type="button" class="close-drawer-btn" onclick="closeAllDrawers();"><i class="material-icons-outlined">close</i></button>
            </div>
            <div style="text-align: center; margin-top: 40px; padding: 0 10px;">
                <div class="material-icons-outlined" style="font-size: 56px; color: var(--text-muted); margin-bottom: 15px; opacity: 0.6;">history</div>
                <div style="font-size: 16px; font-weight: 500; margin-bottom: 10px; color: #fff;">Nothing in the last 30 days</div>
            </div>
            <div class="drawer-footer-link">
                <a href="History.aspx">View Complete History Page</a>
            </div>
        </div>

        <!-- Pop-Up Help Drawer Content Panel -->
        <div class="lms-slide-drawer" id="helpDrawerPanel">
            <div class="drawer-header">
                <h2>LMS Help Desk</h2>
                <button type="button" class="close-drawer-btn" onclick="closeAllDrawers();"><i class="material-icons-outlined">close</i></button>
            </div>
            <div class="help-drawer-links-box">
                <div class="help-drawer-card">
                    <div class="help-card-title">Search the Guides</div>
                    <div class="help-card-desc">Find answers in the formal documentation guidelines.</div>
                </div>
                <div class="help-drawer-card">
                    <div class="help-card-title">Report a Problem</div>
                    <div class="help-card-desc">Submit a ticket directly to technical administrators.</div>
                </div>
            </div>
            <div class="drawer-footer-link">
                <a href="Help.aspx">Open Dedicated Help Page</a>
            </div>
        </div>

        <!-- Main Content Workspace Container -->
        <main class="main-workspace">
            <!-- Student Preview Mode Notification Banner Bar -->
            <asp:Panel ID="pnlStudentPreviewBanner" runat="server" CssClass="student-preview-bar" Style="display: none;">
                <span>You are previewing this course as a student</span>
                <asp:LinkButton ID="btnExitStudentPreview" runat="server" CssClass="exit-preview-link" OnClick="btnExitStudentPreview_Click">
                    Return to teacher view
                </asp:LinkButton>
            </asp:Panel>

            <div class="content-body">
                <asp:ContentPlaceHolder ID="MainContent" runat="server"></asp:ContentPlaceHolder>
            </div>
            <footer class="lms-footer">
                <div>Seiha LMS | Powered by Seiha Technology</div>
                <div>&copy; <%: DateTime.Now.Year %> - Seiha Global Academy</div>
            </footer>
        </main>
    </form>

    <script type="text/javascript">
        var currentPath = window.location.pathname.toLowerCase();

        function highlightNavbar() {
            document.querySelectorAll('.lms-sidebar .nav-item').forEach(function (link) {
                var hrefAttribute = link.getAttribute('href');
                var onclickAttribute = link.getAttribute('onclick');
                link.classList.remove('active');

                if (hrefAttribute) {
                    var cleanHref = hrefAttribute.toLowerCase().replace('.aspx', '');
                    if (currentPath.endsWith(cleanHref) || (cleanHref !== "" && currentPath.includes('/' + cleanHref))) {
                        link.classList.add('active');
                    }
                }
                if (onclickAttribute && onclickAttribute.includes('accountDrawerPanel') &&
                    (currentPath.includes('/profile') || currentPath.includes('/settings') || currentPath.includes('/portfolio') || currentPath.includes('/files') || currentPath.includes('/notifications') || currentPath.includes('/announcements'))) {
                    link.classList.add('active');
                }
                if (currentPath.includes('/history') && onclickAttribute && onclickAttribute.includes('historyDrawerPanel')) {
                    link.classList.add('active');
                }
                if (currentPath.includes('/help') && onclickAttribute && onclickAttribute.includes('helpDrawerPanel')) {
                    link.classList.add('active');
                }
            });
        }

        function toggleDrawer(drawerId, triggerElement) {
            var targetDrawer = document.getElementById(drawerId);
            var isOpen = targetDrawer.classList.contains('open');
            closeAllDrawers();
            if (!isOpen) {
                targetDrawer.classList.add('open');
                document.querySelectorAll('.lms-sidebar .nav-item').forEach(el => el.classList.remove('active'));
                triggerElement.classList.add('active');
            } else {
                highlightNavbar();
            }
        }

        function closeAllDrawers() {
            document.querySelectorAll('.lms-slide-drawer').forEach(drawer => drawer.classList.remove('open'));
            highlightNavbar();
        }

        function toggleSiteTheme(isLightMode) {
            if (isLightMode) {
                document.body.classList.add("light-mode");
                localStorage.setItem("lms-theme", "light");
            } else {
                document.body.classList.remove("light-mode");
                localStorage.setItem("lms-theme", "dark");
            }
        }

        function initAccessibilityToggles() {
            // Sync theme toggle switch position
            var themeToggle = document.getElementById("chkThemeToggle");
            if (themeToggle) {
                themeToggle.checked = document.body.classList.contains("light-mode");
            }

            // Sync High Contrast toggle icon state
            var hcIconWrapper = document.getElementById("highContrastToggleIcon");
            if (hcIconWrapper) {
                if (document.body.classList.contains("high-contrast")) {
                    hcIconWrapper.className = "toggle-icon checked";
                    hcIconWrapper.innerHTML = '<i class="material-icons-outlined">check_circle</i>';
                } else {
                    hcIconWrapper.className = "toggle-icon unchecked";
                    hcIconWrapper.innerHTML = '<i class="material-icons-outlined">cancel</i>';
                }
            }
        }

        function toggleHighContrast() {
            var isHighContrast = document.body.classList.toggle("high-contrast");

            if (isHighContrast) {
                localStorage.setItem("lms-high-contrast", "enabled");
            } else {
                localStorage.removeItem("lms-high-contrast");
            }

            // Re-render visual state
            initAccessibilityToggles();
        }

        // Initialize highlights and layout elements on runtime load
        highlightNavbar();
        initAccessibilityToggles();
    </script>
</body>
</html>